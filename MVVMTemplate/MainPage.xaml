<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mvvmTemplate="clr-namespace:MVVMTemplate"
             x:DataType="mvvmTemplate:MainViewModel"
             x:Class="MVVMTemplate.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25" HorizontalOptions="Center">
            
            <Image Source="dotnet_bot.png"/>

            <Label Text="Hello, World!" FontSize="Title" HorizontalTextAlignment="Center" />

            <Label Text="Welcome to &#10;.NET Multi-platform App UI" 
                   FontSize="Large" HorizontalTextAlignment="Center" />

            <Button Text="{ Binding Count, Converter={StaticResource CountConverter}}" FontSize="Large"
                    Command="{ Binding CounterClickedCommand }"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>